# aigen 项目配置：框架与具体项目之间的唯一接口。复制到项目根目录，改名 aigen.yaml，按本项目修改。
constants: config                  # ${大写常量} 引用的常量模块（账号、地址等）；同名环境变量 / .env 优先
# ac_pattern: "AC-\\d+"            # PRD 验收编号格式，如 "REQ-\\d+"
# encoding: utf-8                  # 材料文件编码
# export_dir: docs/用例            # export 输出目录
# redact:                          # 批量起草发给模型前的脱敏规则（常量真实值会自动替换成 ${常量名}）
#   - {pattern: "1[3-9]\\d{9}", replace: "<PHONE>"}

api:
  base_url: API                    # constants 里的常量名
  timeout: 30                      # 秒
  # headers: {X-Api-Key: "${API_KEY}"}   # 每个请求都带的头
  login:                           # 前置登录 / cleanup_as 用；不需要登录可删掉
    method: POST
    path: /users/login
    user_field: email
    password_field: password
    # body: form                   # 表单登录
    token_field: access_token      # 点路径，如 data.token；不填表示靠 Cookie 保持登录
    header: Authorization
    prefix: "Bearer "
  # oauth2:                        # 和 login 二选一
  #   token_url: /oauth/token
  #   grant: password              # 或 client_credentials（roles 给 [client_id 常量, client_secret 常量]）
  # client_class: mypkg.auth:SignedClient   # 签名类鉴权：继承 aigen.runtime.Client
  roles:                           # precondition / cleanup_as 可用的身份 → [账号常量, 密码常量]
    customer: [CUSTOMER_EMAIL, CUSTOMER_PASSWORD]
    admin: [ADMIN_EMAIL, ADMIN_PASSWORD]

ui:                                # 只用接口用例可删掉
  page_dir: page                   # 页面对象目录
  fixture: page                    # 已打开被测页面的 pytest fixture
  timeout: 5000                    # 毫秒，断言等待上限

materials:                         # source 只能以这些名字（或 实测 / DOM 实测 / 推测）开头
  - {name: OpenAPI, path: docs/openapi.json, kind: openapi}   # JSON / YAML、Swagger 2.0 都可
  - {name: PRD, path: docs/PRD.md, kind: prd}

waive: {}                          # PRD 里不需要用例覆盖的验收：{AC-xx: 原因}
